```python
# src/decision/support_engine.py
class DecisionSupportSystem:
    """
    ChatGPT's government-grade DSS + AntiGravity's alerts
    """
    def __init__(self):
        self.risk_engine = ComprehensiveRiskEngine()
        self.alert_system = AlertSystem()
        self.optimizer = ResourceOptimizer()
        
    async def generate_policy_recommendations(self, region: str) -> Dict:
        """
        Generate policy and conservation recommendations
        """
        # Get comprehensive data
        region_data = await self._get_region_intelligence(region)
        
        # Calculate risks
        risk_report = await self.risk_engine.calculate_risk_score(region_data)
        
        # Get conservation opportunities
        opportunities = await self._identify_conservation_opportunities(region)
        
        # Generate policy suggestions
        policy_suggestions = await self._generate_policies(
            region_data, 
            risk_report,
            opportunities
        )
        
        # Resource allocation advice
        resource_allocation = await self.optimizer.optimize_resources(
            region=region,
            budget=region_data.get('available_budget', 1000000),
            priorities=[
                ('enforcement', risk_report['components']['human_activity_risk']),
                ('conservation', len(opportunities)),
                ('community', region_data.get('community_engagement', 0.5))
            ]
        )
        
        # Comprehensive decision support
        decision_package = {
            'region': region,
            'timestamp': datetime.now(),
            'executive_summary': {
                'overall_risk': risk_report['risk_level'],
                'critical_issues': risk_report['contributing_factors'][:3],
                'top_priority': policy_suggestions['top_recommendation']
            },
            'detailed_analysis': {
                'risk_breakdown': risk_report['components'],
                'conservation_opportunities': opportunities,
                'resource_optimization': resource_allocation
            },
            'policy_suggestions': policy_suggestions['all'],
            'enforcement_priorities': self._prioritize_enforcement(region_data),
            'protection_strategies': self._generate_protection_strategies(region_data),
            'expected_outcomes': self._project_outcomes(
                policy_suggestions['all'],
                resource_allocation
            ),
            'alerts': await self.alert_system.get_active_alerts(region)
        }
        
        # AntiGravity's CSV-based incident tracking
        decision_package['incident_summary'] = await self._get_incident_summary(region)
        
        return decision_package
    
    async def _generate_policies(self, region_data, risk_report, opportunities):
        """ChatGPT's policy generation"""
        
        policies = []
        
        # If high deforestation risk
        if risk_report['components']['human_activity_risk'] > 0.6:
            policies.append({
                'type': 'ENFORCEMENT',
                'priority': 'HIGH',
                'suggestion': 'Increase forest patrol frequency by 50% in identified hotspots',
                'rationale': 'High human activity risk detected',
                'estimated_cost': 50000,
                'expected_impact': '30% reduction in illegal activity'
            })
        
        # If high climate risk
        if risk_report['components']['climate_risk'] > 0.6:
            policies.append({
                'type': 'CLIMATE_ADAPTATION',
                'priority': 'HIGH',
                'suggestion': 'Establish climate-resilient tree planting program',
                'rationale': 'Region showing high climate vulnerability',
                'estimated_cost': 75000,
                'expected_impact': 'Increase forest resilience by 40%'
            })
        
        # If conservation opportunities
        if len(opportunities) > 3:
            policies.append({
                'type': 'CONSERVATION',
                'priority': 'MEDIUM',
                'suggestion': f'Create protected corridors for {len(opportunities)} identified biodiversity zones',
                'rationale': 'High conservation potential identified',
                'estimated_cost': 100000,
                'expected_impact': 'Protect 500 hectares of critical habitat'
            })
        
        # Community engagement
        if region_data.get('community_engagement', 0) < 0.4:
            policies.append({
                'type': 'COMMUNITY',
                'priority': 'MEDIUM',
                'suggestion': 'Launch community awareness program about forestry laws',
                'rationale': 'Low community engagement increases violation risk',
                'estimated_cost': 25000,
                'expected_impact': 'Reduce unintentional violations by 25%'
            })
        
        return {
            'all': policies,
            'top_recommendation': max(policies, key=lambda x: x['priority'] == 'HIGH')
        }

class AlertSystem:
    """
    AntiGravity's alert system + ChatGPT's severity levels
    """
    def __init__(self):
        self.alerts_db = []  # In production: Redis/PostgreSQL
        
    async def create_alert(self, alert_data: Dict):
        """Create new alert"""
        
        alert = {
            'id': str(uuid.uuid4()),
            'type': alert_data['type'],
            'severity': alert_data.get('severity', 'MEDIUM'),
            'region': alert_data.get('region'),
            'message': alert_data['message'],
            'data': alert_data.get('data', {}),
            'recommended_action': alert_data.get('recommended_action'),
            'created_at': datetime.now(),
            'status': 'active',
            'resolved_at': None,
            'resolved_by': None
        }
        
        self.alerts_db.append(alert)
        
        # AntiGravity's UI integration
        if alert['severity'] in ['HIGH', 'CRITICAL']:
            await self._send_immediate_notification(alert)
        
        return alert
    
    async def resolve_alert(self, alert_id: str, resolved_by: str):
        """AntiGravity's resolve button functionality"""
        for alert in self.alerts_db:
            if alert['id'] == alert_id:
                alert['status'] = 'resolved'
                alert['resolved_at'] = datetime.now()
                alert['resolved_by'] = resolved_by
                return alert
        return None
    
    async def get_active_alerts(self, region: str = None):
        """Get all active alerts"""
        active = [a for a in self.alerts_db if a['status'] == 'active']
        
        if region:
            active = [a for a in active if a.get('region') == region]
        
        # Sort by severity
        severity_order = {'CRITICAL': 0, 'HIGH': 1, 'MEDIUM': 2, 'LOW': 3}
        active.sort(key=lambda x: severity_order.get(x['severity'], 4))
        
        return active
```

