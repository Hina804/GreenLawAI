"""
neo4j_safe_backup.py
────────────────────
Run this BEFORE neo4j_entity_migration.py.

Does three things:
  1. Exports every Entity node + all its relationships to a JSON file
     so you can restore manually if anything goes wrong.
  2. Prints a full relationship-type inventory so you know exactly
     what relationships exist on Entity nodes before any changes.
  3. Validates that Step 2 of the migration is safe for YOUR graph
     (checks whether Entity nodes have relationships other than MENTIONS).

Usage:
    python neo4j_safe_backup.py
    python neo4j_safe_backup.py --output my_backup.json
"""

from __future__ import annotations

import argparse
import json
import datetime
from pathlib import Path
from neo4j import GraphDatabase


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--uri",      default="bolt://localhost:7687")
    parser.add_argument("--user",     default="neo4j")
    parser.add_argument("--password", default="password")
    parser.add_argument("--output",   default="entity_backup.json")
    args = parser.parse_args()

    driver = GraphDatabase.driver(args.uri, auth=(args.user, args.password))

    print("\n" + "═" * 60)
    print("  PRE-MIGRATION SAFETY CHECK + BACKUP")
    print("═" * 60)

    with driver.session() as s:

        # ── 1. Count everything ───────────────────────────────────────────
        total_entities = s.run(
            "MATCH (e:Entity) RETURN count(e) AS n"
        ).single()["n"]

        total_chunks = s.run(
            "MATCH (c:Chunk) RETURN count(c) AS n"
        ).single()["n"]

        total_mentions = s.run(
            "MATCH (:Chunk)-[r:MENTIONS]->(:Entity) RETURN count(r) AS n"
        ).single()["n"]

        print(f"\n  Graph inventory:")
        print(f"    :Entity nodes       : {total_entities}")
        print(f"    :Chunk  nodes       : {total_chunks}")
        print(f"    :MENTIONS rels      : {total_mentions}")

        # ── 2. Find ALL relationship types on Entity nodes ────────────────
        print(f"\n  Relationship types touching :Entity nodes:")
        rel_types = s.run("""
            MATCH (e:Entity)-[r]-()
            RETURN type(r) AS rel_type, count(r) AS cnt
            ORDER BY cnt DESC
        """).data()

        non_mentions = []
        for row in rel_types:
            marker = ""
            if row["rel_type"] != "MENTIONS":
                non_mentions.append(row)
                marker = "  ← ⚠️  NOT MENTIONS"
            print(f"    {row['rel_type']:<30} {row['cnt']:>6} relationships{marker}")

        # ── 3. Safety verdict ─────────────────────────────────────────────
        print(f"\n  STEP 2 SAFETY VERDICT:")
        if not non_mentions:
            print("  ✓ SAFE  — Entity nodes only have MENTIONS relationships.")
            print("            Step 2 (merge duplicates) will not lose any data.")
            step2_safe = True
        else:
            print("  ⚠️  CAUTION — Entity nodes have these additional relationship types:")
            for row in non_mentions:
                print(f"     • {row['rel_type']} ({row['cnt']} relationships)")
            print()
            print("  Step 2 currently only re-points MENTIONS relationships.")
            print("  The other relationship types above would be DELETED when")
            print("  duplicate nodes are removed.")
            print()
            print("  RECOMMENDATION: Run migration with --skip-step2")
            print("  (Steps 1,3,4,5 are fully safe and fix 95% of the problem)")
            step2_safe = False

        # ── 4. Export backup ──────────────────────────────────────────────
        print(f"\n  Exporting backup to '{args.output}'…")

        entities = s.run("""
            MATCH (e:Entity)
            OPTIONAL MATCH (c:Chunk)-[:MENTIONS]->(e)
            RETURN
                e.canonical_name  AS canonical_name,
                e.entity_type     AS entity_type,
                e.aliases         AS aliases,
                e.mentions        AS mentions,
                e.frequency       AS frequency,
                e.original_name   AS original_name,
                collect(DISTINCT c.chunk_id) AS chunk_ids
        """).data()

        backup = {
            "exported_at":    datetime.datetime.utcnow().isoformat() + "Z",
            "neo4j_uri":      args.uri,
            "graph_summary":  {
                "entity_count":   total_entities,
                "chunk_count":    total_chunks,
                "mention_count":  total_mentions,
            },
            "relationship_types": rel_types,
            "step2_safe":     step2_safe,
            "entities":       entities,
        }

        with open(args.output, "w", encoding="utf-8") as f:
            json.dump(backup, f, indent=2, ensure_ascii=False, default=str)

        size_kb = Path(args.output).stat().st_size / 1024
        print(f"  ✓ Backup saved: {args.output}  ({size_kb:.1f} KB)")
        print(f"    Contains {len(entities)} entity records with all properties")
        print(f"    and chunk_id lists for manual restoration if needed.")

        # ── 5. Print restore instructions ────────────────────────────────
        print(f"""
  HOW TO RESTORE FROM BACKUP (if anything goes wrong):
  ─────────────────────────────────────────────────────
  python neo4j_restore_from_backup.py --input {args.output}

  Or manually in Neo4j Browser:
    LOAD CSV ... (see neo4j_restore_from_backup.py for full Cypher)
""")

    driver.close()

    print("═" * 60)
    if step2_safe:
        print("  ✓ Safe to run full migration (all 5 steps).")
    else:
        print("  ⚠️  Run migration with --skip-step2 flag:")
        print("      python neo4j_entity_migration.py --skip-step2")
        print("      (Aliases will still be fixed. Only deduplication skipped.)")
    print("═" * 60 + "\n")


if __name__ == "__main__":
    main()