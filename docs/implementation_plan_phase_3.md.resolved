# src/ops/logging.py
import loguru
from loguru import logger

class OperationalHardening:
    """
    AntiGravity's Loguru integration + rate limiting
    """
    def __init__(self):
        # Configure Loguru
        logger.add(
            "logs/greenlaw_{time}.log",
            rotation="500 MB",
            retention="30 days",
            compression="zip",
            format="{time:YYYY-MM-DD HH:mm:ss} | {level} | {name}:{function}:{line} | {message}",
            level="INFO"
        )
        
        # Error logging
        logger.add(
            "logs/errors_{time}.log",
            rotation="100 MB",
            retention="90 days",
            level="ERROR",
            backtrace=True,
            diagnose=True
        )
        
        # Rate limiter
        self.rate_limiter = RateLimiter(
            max_requests_per_minute=60,
            burst_limit=100
        )
        
    async def log_agent_action(self, agent_name: str, action: str, duration_ms: int):
        """Structured logging for agent actions"""
        
        logger.info(f"Agent={agent_name} | Action={action} | Duration={duration_ms}ms")
        
        # Also log to metrics DB
        await self._log_metric('agent_action', {
            'agent': agent_name,
            'action': action,
            'duration_ms': duration_ms,
            'timestamp': datetime.now()
        })
    
    async def log_error(self, error: Exception, context: Dict):
        """Comprehensive error logging"""
        
        logger.error(
            f"Error={error.__class__.__name__} | Message={str(error)} | "
            f"Context={json.dumps(context, default=str)}"
        )
        
        # Stack trace
        logger.exception("Exception details:")
        
        # Alert on critical errors
        if self._is_critical_error(error):
            await self._send_error_alert(error, context)
    
    async def check_rate_limit(self, user_id: str) -> bool:
        """AntiGravity's rate limiting"""
        return await self.rate_limiter.check(user_id)

# Final testing suite
class Phase3TestSuite:
    """
    Comprehensive testing for Phase 3
    """
    async def run_all_tests(self):
        results = {
            'adaptive_learning': await self.test_adaptive_learning(),
            'knowledge_evolution': await self.test_knowledge_evolution(),
            'gis_integration': await self.test_gis(),
            'climate_apis': await self.test_climate_apis(),
            'prediction_models': await self.test_predictions(),
            'risk_engine': await self.test_risk_engine(),
            'decision_support': await self.test_dss(),
            'memory_persistence': await self.test_memory(),
            'operational_hardening': await self.test_ops()
        }
        
        # Calculate overall
        passed = sum(1 for r in results.values() if r['passed'])
        total = len(results)
        
        return {
            'passed_tests': passed,
            'total_tests': total,
            'success_rate': f"{passed/total*100:.1f}%",
            'detailed': results,
            'phase3_complete': passed == total
        }
