```python
# src/learning/feedback_system.py
class FeedbackSystem:
    """
    ChatGPT's learning store + Original's feedback collection
    """
    def __init__(self):
        # ChatGPT's structured tables
        self.db = PostgreSQLDatabase()
        self._init_tables()
        
    def _init_tables(self):
        """Create learning store tables"""
        tables = """
        CREATE TABLE IF NOT EXISTS user_queries (
            id SERIAL PRIMARY KEY,
            user_id VARCHAR(100),
            query TEXT,
            intent VARCHAR(50),
            timestamp TIMESTAMP
        );
        
        CREATE TABLE IF NOT EXISTS agent_responses (
            id SERIAL PRIMARY KEY,
            query_id INTEGER REFERENCES user_queries(id),
            agent_name VARCHAR(50),
            response TEXT,
            confidence FLOAT,
            latency_ms INTEGER
        );
        
        CREATE TABLE IF NOT EXISTS feedback_scores (
            id SERIAL PRIMARY KEY,
            response_id INTEGER REFERENCES agent_responses(id),
            rating INTEGER CHECK (rating >= 1 AND rating <= 5),
            helpful BOOLEAN,
            corrections TEXT,
            timestamp TIMESTAMP
        );
        
        CREATE TABLE IF NOT EXISTS confidence_tracking (
            id SERIAL PRIMARY KEY,
            query_pattern TEXT,
            agent_name VARCHAR(50),
            avg_confidence FLOAT,
            sample_count INTEGER
        );
        """
        self.db.execute(tables)
    
    async def collect_feedback(self, interaction_data: Dict):
        """Original's comprehensive feedback collection"""
        
        # Store query
        query_id = await self.db.insert('user_queries', {
            'user_id': interaction_data['user_id'],
            'query': interaction_data['query'],
            'intent': interaction_data['intent'],
            'timestamp': datetime.now()
        })
        
        # Store responses
        for agent_response in interaction_data['responses']:
            response_id = await self.db.insert('agent_responses', {
                'query_id': query_id,
                'agent_name': agent_response['agent'],
                'response': agent_response['text'],
                'confidence': agent_response['confidence'],
                'latency_ms': agent_response['latency']
            })
            
            # Store feedback if provided
            if 'feedback' in interaction_data:
                await self.db.insert('feedback_scores', {
                    'response_id': response_id,
                    'rating': interaction_data['feedback']['rating'],
                    'helpful': interaction_data['feedback']['helpful'],
                    'corrections': interaction_data['feedback'].get('corrections'),
                    'timestamp': datetime.now()
                })
        
        # Update confidence tracking
        await self._update_confidence_metrics(
            interaction_data['query'],
            interaction_data['intent'],
            interaction_data['responses']
        )
    
    async def get_learning_insights(self):
        """Extract patterns from feedback"""
        
        # ChatGPT's learning metrics
        insights = {
            'low_confidence_patterns': await self._find_low_confidence_patterns(),
            'common_corrections': await self._analyze_corrections(),
            'improvement_areas': await self._identify_gaps(),
            'popular_queries': await self._get_popular_queries(),
            'agent_performance': await self._agent_performance_breakdown()
        }
        
        return insights
```

### **WEEK 2: Knowledge Evolution System**

#### *From ChatGPT: Knowledge Evolution Architecture*
#### *From AntiGravity: Versioning Approach*

```python
# src/knowledge/knowledge_evolution.py
class KnowledgeEvolutionSystem:
    """
    ChatGPT's knowledge evolution + AntiGravity's versioning
    """
    def __init__(self):
        self.version_control = KnowledgeVersionControl()
        self.validation_engine = ValidationEngine()
        
    async def evolve_knowledge(self):
        """Continuous knowledge improvement cycle"""
        
        # ChatGPT's evolution cycle
        cycle_results = {
            'validation': await self._validate_current_knowledge(),
            'updates': await self._check_for_updates(),
            'versioning': None,
            'archived': []
        }
        
        # Check for new legal documents
        new_docs = await self._fetch_new_documents()
        
        for doc in new_docs:
            # Validate
            is_valid = await self.validation_engine.validate(doc)
            
            if is_valid:
                # AntiGravity's versioning
                new_version = await self.version_control.create_version(
                    document=doc,
                    source=doc['source'],
                    timestamp=datetime.now()
                )
                
                # Add to knowledge base
                await self._add_to_knowledge_base(new_version)
                
                cycle_results['updates'].append({
                    'document': doc['title'],
                    'version': new_version,
                    'status': 'added'
                })
            else:
                cycle_results['validation'].append({
                    'document': doc['title'],
                    'status': 'failed_validation',
                    'reason': doc.get('validation_error')
                })
        
        # Archive old versions (AntiGravity)
        archived = await self.version_control.archive_outdated(
            older_than_days=365
        )
        cycle_results['archived'] = archived
        
        return cycle_results
    
    async def _validate_current_knowledge(self):
        """Stale knowledge detection"""
        
        # ChatGPT's validation
        validation_results = []
        
        for doc in self.knowledge_base.get_all():
            age_days = (datetime.now() - doc['last_verified']).days
            
            if age_days > 180:  # 6 months
                validation_results.append({
                    'document': doc['title'],
                    'status': 'needs_review',
                    'age_days': age_days
                })
            
            if age_days > 365:  # 1 year
                validation_results.append({
                    'document': doc['title'],
                    'status': 'stale',
                    'action': 'archive_or_update'
                })
        
        return validation_results

class KnowledgeVersionControl:
    """AntiGravity's versioning system"""
    
    def __init__(self):
        self.versions = {}
        self.version_history = []
        
    async def create_version(self, document: Dict, source: str, timestamp: datetime):
        """Create new version with tracking"""
        
        version_id = f"{document['id']}_v{timestamp.strftime('%Y%m%d_%H%M%S')}"
        
        version = {
            'version_id': version_id,
            'document': document,
            'source': source,
            'created_at': timestamp,
            'previous_version': self._get_latest_version(document['id']),
            'changes': self._compute_changes(document)
        }
        
        self.versions[version_id] = version
        self.version_history.append(version_id)
        
        return version_id
    
    async def archive_outdated(self, older_than_days: int):
        """Archive old versions"""
        cutoff = datetime.now() - timedelta(days=older_than_days)
        
        to_archive = []
        for version_id, version in self.versions.items():
            if version['created_at'] < cutoff:
                to_archive.append(version_id)
                # Move to cold storage
                await self._move_to_archive(version_id)
        
        return to_archive
```

