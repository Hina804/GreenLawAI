# src/gis/spatial_intelligence.py
class SpatialIntelligenceEngine:
    """
    ChatGPT's spatial intelligence + AntiGravity's maps + Original's layers
    """
    def __init__(self):
        self.gis_layers = {
            'forest_cover': ForestCoverLayer(),
            'protected_areas': ProtectedAreasLayer(),
            'deforestation_hotspots': DeforestationLayer(),
            'fire_risk_zones': FireRiskLayer(),
            'incident_locations': IncidentLayer()
        }
        
    async def get_region_data(self, region_name: str):
        """ChatGPT's region intelligence"""
        
        # Get all spatial data for region
        region_data = {
            'name': region_name,
            'coordinates': await self._get_region_coordinates(region_name),
            'forest_cover': await self._get_forest_cover(region_name),
            'protected_status': await self._get_protected_status(region_name),
            'climate_risk': await self._assess_climate_risk(region_name),
            'deforestation_rate': await self._get_deforestation_rate(region_name),
            'recent_incidents': await self._get_incidents_in_region(region_name)
        }
        
        # Calculate zone risk (ChatGPT's risk scoring)
        region_data['risk_score'] = self._calculate_risk_score(region_data)
        
        return region_data
    
    async def create_incident_map(self, incidents_df, center_lat=None, center_lon=None):
        """
        AntiGravity's st.map() visualization
        """
        import streamlit as st
        import pandas as pd
        
        if 'latitude' in incidents_df.columns and 'longitude' in incidents_df.columns:
            # Filter out null coordinates
            map_data = incidents_df[['latitude', 'longitude']].dropna()
            
            if len(map_data) > 0:
                # Create Streamlit map
                st.map(map_data)
                
                # Add incident details in sidebar
                st.sidebar.subheader("📍 Incident Details")
                for idx, row in incidents_df.iterrows():
                    if pd.notna(row.get('latitude')):
                        with st.sidebar.expander(f"{row.get('date')} - {row.get('incident_type')}"):
                            st.write(f"**Location:** {row.get('location')}")
                            st.write(f"**District:** {row.get('district')}")
                            st.write(f"**Status:** {row.get('status')}")
                            st.write(f"**Details:** {row.get('details')}")
                            
                            # AntiGravity's resolve button
                            if row.get('status') == 'open':
                                if st.button(f"Resolve #{idx}", key=f"resolve_{idx}"):
                                    await self.resolve_incident(idx)
                                    st.success("Incident resolved!")
                                    st.rerun()
                
                return map_data
        return None
    
    async def find_deforestation_hotspots(self, country: str, year: int):
        """Original's hotspot detection"""
        
        # Get satellite data
        satellite_data = await self._get_satellite_imagery(country, year)
        
        # Run change detection
        changes = await self._detect_changes(satellite_data)
        
        # Cluster into hotspots
        from sklearn.cluster import DBSCAN
        hotspots = DBSCAN(eps=0.1, min_samples=5).fit(changes['coordinates'])
        
        return {
            'total_hotspots': len(set(hotspots.labels_)) - (1 if -1 in hotspots.labels_ else 0),
            'hotspot_centers': self._get_cluster_centers(changes, hotspots),
            'total_area_affected': changes['total_area'],
            'severity_map': await self._create_severity_map(changes)
        }
```

